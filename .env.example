DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/nusawis
SECRET_KEY=ganti-dengan-string-acak-minimal-32-karakter
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
CORS_ORIGINS=*

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_FAIL_OPEN=false
USER_CACHE_TTL_SECONDS=300

# --- JWT ---
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=nusawis-api
JWT_AUDIENCE=nusawis-client

# --- Rate limit & lockout ---
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW_SECONDS=3600
REFRESH_RATE_LIMIT=30
REFRESH_RATE_WINDOW_SECONDS=60
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
TRUST_PROXY_HEADERS=false
